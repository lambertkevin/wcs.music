{
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && dotenv -e ../../.env -- c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && dotenv -e ../../.env -- fastify start -l info dist/src/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
    "dev:start": "dotenv -e ../../.env -- fastify start --ignore-watch='tmp node_modules dist .tokens.json' -w -l trace -P dist/src/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "node-shazam": "^1.2.7",
    "pg": "^8.21.0",
    "tiny-async-pool": "^2.1.0",
    "ytdlp-nodejs": "^3.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/tiny-async-pool": "^2.0.3",
    "c8": "^11.0.0",
    "concurrently": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fastify-tsconfig": "^3.0.0",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.4.2",
    "prisma": "^7.8.0",
    "typescript-eslint": "^8.59.4"
  }
}